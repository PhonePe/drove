{
  "name": "TEST_APP",
  "version": "4",
  "type": "SERVICE",
  "executable": {
    "type": "DOCKER",
    "url": "ghcr.io/appform-io/perf-test-server-httplib",
    "dockerPullTimeout": "100 seconds"
  },
  "exposedPorts": [
    {
      "name": "main",
      "port": 8000,
      "type": "HTTP"
    }
  ],
  "volumes": [],
  "configs": [
    {
      "type": "INLINE",
      "localFilename": "/testfiles/drove.txt",
      "data": "RHJvdmUgdGVzdA=="
    }
  ],
  "resources": [
    {
      "type": "CPU",
      "count": 1
    },
    {
      "type": "GPU",
      "count": 1,
      "gpuType": {
        "vendor": "NVIDIA",
        "model": "h100_80gb_hbm"
      }
    },
    {
      "type": "MEMORY",
      "sizeInMB": 128
    }
  ],
  "placementPolicy": {
    "type": "ANY"
  },
  "healthcheck": {
    "mode": {
      "type": "HTTP",
      "protocol": "HTTP",
      "portName": "main",
      "path": "/",
      "verb": "GET",
      "successCodes": [
        200
      ],
      "payload": "",
      "connectionTimeout": "1 second"
    },
    "timeout": "1 second",
    "interval": "5 seconds",
    "attempts": 3,
    "initialDelay": "0 seconds"
  },
  "readiness": {
    "mode": {
      "type": "HTTP",
      "protocol": "HTTP",
      "portName": "main",
      "path": "/",
      "verb": "GET",
      "successCodes": [
        200
      ],
      "payload": "",
      "connectionTimeout": "1 second"
    },
    "timeout": "1 second",
    "interval": "3 seconds",
    "attempts": 3,
    "initialDelay": "0 seconds"
  },
  "tags": {
    "superSpecialApp": "yes_i_am",
    "say_my_name": "heisenberg",
    "environment": "dev",
    "region": "dc1"
  },
  "env": {
    "CORES": "8"
  },
  "exposureSpec": {
    "vhost": "testapp.local",
    "portName": "main",
    "mode": "ALL"
  },
  "preShutdown": {
    "hooks": [
      {
        "type": "HTTP",
        "protocol": "HTTP",
        "portName": "main",
        "path": "/",
        "verb": "GET",
        "successCodes": [
          200
        ],
        "payload": "",
        "connectionTimeout": "1 second"
      }
    ],
    "waitBeforeKill": "3 seconds"
  }
}
