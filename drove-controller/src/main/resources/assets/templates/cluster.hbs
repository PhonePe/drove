{{#partial "content"}}
    <style>
        table.dataTable tr.dtrg-group { cursor: pointer; }
        table.dataTable tr.dtrg-group th {
            background-color: #e9ecef;
            color: #212529 !important;
            border-top: 2px solid #dee2e6;
            border-bottom: 2px solid #dee2e6;
            text-align: left;
        }
        table.dataTable tr.dtrg-group th .text-body-secondary {
            color: #495057 !important;
        }
        table.dataTable tr.dtrg-group th .dtrg-toggle {
            margin-right: 0.5rem;
            transition: transform 0.2s;
        }
        table.dataTable tr.dtrg-group.collapsed .dtrg-toggle {
            transform: rotate(-90deg);
        }
        table.dataTable tr.dtrg-group.collapsed ~ tr:not(.dtrg-group) {
            display: none;
        }
    </style>
    <section>
        <ul class="nav nav-tabs mb-3" id="cluster-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="executors-tab" data-bs-toggle="tab" data-bs-target="#executors-pane" type="button" role="tab" aria-selected="true">Executors</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="gpus-tab" data-bs-toggle="tab" data-bs-target="#gpus-pane" type="button" role="tab" aria-selected="false">GPUs <span class="badge bg-secondary" id="gpu-count-badge" style="display:none;"></span></button>
            </li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="executors-pane" role="tabpanel" aria-labelledby="executors-tab" tabindex="0">
                <div class="row">
                    <div class="col">
                        <table class="table table-bordered" id="executors" style="width: 100%">
                            <thead>
                            <tr>
                                <th data-priority="11000">ID</th>
                                <th>Host</th>
                                <th>State</th>
                                <th>Free Cores</th>
                                <th>Used Cores</th>
                                <th>Free Memory</th>
                                <th>Used Memory</th>
                                <th data-priority="10500">Tags</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="gpus-pane" role="tabpanel" aria-labelledby="gpus-tab" tabindex="0">
                <div class="row">
                    <div class="col">
                        <table class="table table-bordered" id="gpus" style="width: 100%">
                            <thead>
                            <tr>
                                <th>Host</th>
                                <th>GPU ID</th>
                                <th>Vendor</th>
                                <th>Model</th>
                                <th>State</th>
                                <th>NUMA</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
{{/partial}}

{{#partial "page_js"}}
    const executors = $('#executors').DataTable({
        processing: true,
        ajax: '/apis/v1/cluster/executors',
        paging: true,
        pageLength: 20,
        lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        info: false,
        responsive: false,
        scrollX: true,
        columnDefs: [
            {
                className: 'text-start text-nowrap',
                targets: 0
            },
            {
                className: 'text-center text-wrap',
                targets: [1,2,3,4,5,6]
            }
        ],
        columns: [
            {
                data: 'executorId',
                render: function(data, type, row, meta) {
                    if(type === 'display') {
                        const link = '<a href="/executors/{0}" class="fw-semibold">{1}</a>'.format(row.executorId, row.executorId);
                        return (row.state == 'REMOVED' || row.state == 'BLACKLISTED')
                            ? '<del>{0}</del>'.format(link)
                            : link;
                    }
                    return data;
                }
            },
            { data: 'hostname' },
            { data: 'state', render: tableExecutorStateText },
            { data: 'freeCores' },
            { data: 'usedCores' },
            { data: 'freeMemory', render: tableBytesText },
            { data: 'usedMemory', render: tableBytesText },
            {
                data: 'tags',
                render: function(data, type, row, meta) {
                    if(type === 'sort') {
                        return data.join(',');
                    }
                    var tagStr = "";
                    if(!data) {
                       return tagStr;
                    }
                    data.sort();
                    for(var i = 0; i < data.length; i++) {
                       tagStr += '<span class="badge bg-secondary text-wrap">' + data[i] + '</span> ';
                    }
                    return tagStr;
                }
            }
        ]
    });

    const gpuTable = $('#gpus').DataTable({
        processing: true,
        ajax: '/apis/v1/cluster/gpus',
        paging: true,
        pageLength: 20,
        lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        info: false,
        responsive: false,
        scrollX: true,
        order: [[2, 'asc'], [0, 'asc']],
        columnDefs: [
            {
                className: 'text-start text-nowrap',
                targets: [0, 1]
            },
            {
                className: 'text-center text-wrap',
                targets: [2, 3, 4, 5]
            },
            { visible: false, targets: 2 }
        ],
        columns: [
            {
                data: 'hostname',
                render: function(data, type, row, meta) {
                    if(type === 'display') {
                        return '<a href="/executors/{0}" class="fw-semibold">{1}</a>'
                                .format(row.executorId, data)
                            + '<div class="text-body-secondary" style="font-size:0.72rem;">' + row.executorId + '</div>';
                    }
                    return data;
                }
            },
            { data: 'gpuId' },
            { data: 'vendor' },
            { data: 'model' },
            {
                data: 'state',
                render: function(data, type, row, meta) {
                    if(type !== 'display') {
                        return data;
                    }
                    var badgeClass = data === 'FREE' ? 'bg-success' : 'bg-danger';
                    return '<span class="badge ' + badgeClass + '">' + data + '</span>';
                }
            },
            {
                data: 'numaNodeAffinity',
                render: function(data, type, row, meta) {
                    if(type !== 'display' || data === null || data === undefined) {
                        return data;
                    }
                    return data;
                }
            }
        ],
        drawCallback: function(settings) {
            var api = this.api();
            var colspan = api.columns().visible().reduce(function(a, b) { return a + b; }, 0);
            var rowData = api.rows({page: 'current'}).data();
            var groupCounts = {};
            for(var i = 0; i < rowData.length; i++) {
                var v = rowData[i].vendor;
                groupCounts[v] = (groupCounts[v] || 0) + 1;
            }
            var nodes = api.rows({page: 'current'}).nodes();
            var last = null;
            for(var i = 0; i < nodes.length; i++) {
                var data = rowData[i];
                var group = data.vendor;
                if(last !== group) {
                    $(nodes[i]).before(
                        '<tr class="dtrg-group dtrg-start dtrg-level-0">'
                        + '<th colspan="' + colspan + '" scope="row" class="fw-bold">'
                        + '<span class="dtrg-toggle">&#9660;</span>'
                        + '<span class="badge bg-secondary">' + group + '</span>'
                        + ' <span class="text-body-secondary">' + groupCounts[group] + ' devices</span>'
                        + '</th></tr>');
                    last = group;
                }
            }
            $('#gpus tbody tr.dtrg-group').off('click').on('click', function() {
                $(this).toggleClass('collapsed');
            });
        }
    });

    setInterval(() => {
        executors.ajax.reload(null, false);
        if($('#gpus-pane').hasClass('show')) {
            gpuTable.ajax.reload(null, false);
        }
    }, 5000);

    $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function(e) {
        if($(e.target).attr('id') === 'gpus-tab') {
            gpuTable.ajax.reload(null, false);
        }
    });
{{/partial}}
{{> common/base}}
