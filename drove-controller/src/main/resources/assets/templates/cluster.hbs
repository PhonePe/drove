{{#partial "content"}}
    <section>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-semibold mb-0">Executors</h5>
            <div class="d-flex gap-2" id="executors-column-groups"></div>
        </div>
        <table class="table table-bordered" id="executors" style="width: 100%">
            <thead>
            <tr>
                <th data-priority="11000">ID</th>
                <th>Host</th>
                <th>State</th>
                <th>Free Cores</th>
                <th>Used Cores</th>
                <th>Free Memory</th>
                <th>Used Memory</th>
                <th class="gpu-col">GPU</th>
                <th class="gpu-col">Free GPUs</th>
                <th class="gpu-col">Used GPUs</th>
                <th data-priority="10500">Tags</th>
            </tr>
            </thead>
        </table>
    </section>
{{/partial}}

{{#partial "page_js"}}
    const executors = $('#executors').DataTable({
        processing: true,
        ajax: '/apis/v1/cluster/executors',
        paging: true,
        pageLength: 20,
        lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        info: false,
        responsive: false,
        scrollX: true,
        columnDefs: [
            {
                className: 'text-start text-nowrap',
                targets: 0
            },
            {
                className: 'text-center text-wrap',
                targets: [1,2,3,4,5,6]
            },
            {
                className: 'gpu-col text-center text-nowrap',
                targets: [7, 8]
            },
            {
                className: 'gpu-col text-start text-wrap',
                targets: 9
            },
            { visible: false, targets: 'gpu-col' }
        ],
        columns: [
            {
                data: 'executorId',
                render: function(data, type, row, meta) {
                    if(type === 'display') {
                        const link = '<a href="/executors/{0}" class="fw-semibold">{1}</a>'.format(row.executorId, row.executorId);
                        return (row.state == 'REMOVED' || row.state == 'BLACKLISTED')
                            ? '<del>{0}</del>'.format(link)
                            : link;
                    }
                    return data;
                }
            },
            { data: 'hostname' },
            { data: 'state', render: tableExecutorStateText },
            { data: 'freeCores' },
            { data: 'usedCores' },
            { data: 'freeMemory', render: tableBytesText },
            { data: 'usedMemory', render: tableBytesText },
            {
                data: 'gpuModel',
                render: function(data, type, row) {
                    if(type !== 'display') {
                        return data || '';
                    }
                    if(!data && !row.gpuVendor) {
                        return '—';
                    }
                    var model = data || '';
                    var vendor = row.gpuVendor || '';
                    if(vendor) {
                        return '<span class="text-body-secondary" style="font-size:0.72rem;">' + vendor + '</span> ' + model;
                    }
                    return model || '—';
                }
            },
            {
                data: 'freeGpus',
                render: function(data) {
                    return data || 0;
                }
            },
            {
                data: 'usedGpus',
                render: function(data) {
                    return data || 0;
                }
            },
            {
                data: 'tags',
                render: function(data, type, row, meta) {
                    if(type === 'sort') {
                        return data.join(',');
                    }
                    var tagStr = "";
                    if(!data) {
                       return tagStr;
                    }
                    data.sort();
                    for(var i = 0; i < data.length; i++) {
                       tagStr += '<span class="badge bg-secondary text-wrap">' + data[i] + '</span> ';
                    }
                    return tagStr;
                }
            }
        ]
    });

    setupColumnGroups(executors, '#executors-column-groups', [
        {
            key: 'gpu',
            label: 'GPU',
            cols: '.gpu-col',
            hasData: function(row) {
                return (row.freeGpus > 0) || (row.usedGpus > 0);
            }
        }
    ]);

    setInterval(() => {
        executors.ajax.reload(null, false);
    }, 5000);
{{/partial}}
{{> common/base}}
