{{#partial "content"}}
    <section>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-semibold mb-0">Executors</h5>
            <button class="btn btn-sm btn-outline-secondary" id="gpu-columns-toggle" type="button" style="display:none;">
                Show GPU columns
            </button>
        </div>
        <table class="table table-bordered" id="executors" style="width: 100%">
            <thead>
            <tr>
                <th data-priority="11000">ID</th>
                <th>Host</th>
                <th>State</th>
                <th>Free Cores</th>
                <th>Used Cores</th>
                <th>Free Memory</th>
                <th>Used Memory</th>
                <th>GPU</th>
                <th>Free GPUs</th>
                <th>Used GPUs</th>
                <th data-priority="10500">Tags</th>
            </tr>
            </thead>
        </table>
    </section>
{{/partial}}

{{#partial "page_js"}}
    const GPU_COL_INFO = 7;
    const GPU_COL_FREE = 8;
    const GPU_COL_USED = 9;
    const GPU_COLS = [GPU_COL_INFO, GPU_COL_FREE, GPU_COL_USED];
    var gpuColumnsVisible = false;

    const executors = $('#executors').DataTable({
        processing: true,
        ajax: '/apis/v1/cluster/executors',
        paging: true,
        pageLength: 20,
        lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        info: false,
        responsive: false,
        scrollX: true,
        columnDefs: [
            {
                className: 'text-start text-nowrap',
                targets: 0
            },
            {
                className: 'text-center text-wrap',
                targets: [1,2,3,4,5,6]
            },
            {
                className: 'text-center text-nowrap',
                targets: [GPU_COL_FREE, GPU_COL_USED]
            },
            {
                className: 'text-start text-wrap',
                targets: [GPU_COL_INFO]
            },
            { visible: false, targets: GPU_COLS }
        ],
        columns: [
            {
                data: 'executorId',
                render: function(data, type, row, meta) {
                    if(type === 'display') {
                        const link = '<a href="/executors/{0}" class="fw-semibold">{1}</a>'.format(row.executorId, row.executorId);
                        return (row.state == 'REMOVED' || row.state == 'BLACKLISTED')
                            ? '<del>{0}</del>'.format(link)
                            : link;
                    }
                    return data;
                }
            },
            { data: 'hostname' },
            { data: 'state', render: tableExecutorStateText },
            { data: 'freeCores' },
            { data: 'usedCores' },
            { data: 'freeMemory', render: tableBytesText },
            { data: 'usedMemory', render: tableBytesText },
            {
                data: 'gpuModel',
                render: function(data, type, row, meta) {
                    if(type !== 'display') {
                        return data || '';
                    }
                    if(!data && !row.gpuVendor) {
                        return '—';
                    }
                    var model = data || '';
                    var vendor = row.gpuVendor || '';
                    if(vendor) {
                        return '<span class="text-body-secondary" style="font-size:0.72rem;">' + vendor + '</span> ' + model;
                    }
                    return model || '—';
                }
            },
            {
                data: 'freeGpus',
                render: function(data, type, row, meta) {
                    return data || 0;
                }
            },
            {
                data: 'usedGpus',
                render: function(data, type, row, meta) {
                    return data || 0;
                }
            },
            {
                data: 'tags',
                render: function(data, type, row, meta) {
                    if(type === 'sort') {
                        return data.join(',');
                    }
                    var tagStr = "";
                    if(!data) {
                       return tagStr;
                    }
                    data.sort();
                    for(var i = 0; i < data.length; i++) {
                       tagStr += '<span class="badge bg-secondary text-wrap">' + data[i] + '</span> ';
                    }
                    return tagStr;
                }
            }
        ]
    });

    executors.on('xhr', function() {
        var data = executors.ajax.json();
        if(data && data.data) {
            var hasGpus = data.data.some(function(row) {
                return (row.freeGpus > 0) || (row.usedGpus > 0);
            });
            $('#gpu-columns-toggle').toggle(hasGpus);
        }
    });

    $('#gpu-columns-toggle').on('click', function() {
        gpuColumnsVisible = !gpuColumnsVisible;
        GPU_COLS.forEach(function(col) {
            executors.column(col).visible(gpuColumnsVisible);
        });
        $(this).text(gpuColumnsVisible ? 'Hide GPU columns' : 'Show GPU columns');
    });

    setInterval(() => {
        executors.ajax.reload(null, false);
    }, 5000);
{{/partial}}
{{> common/base}}
